{
  "name": "portfolio",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "predev": "node scripts/generate-icons-css.mjs",
    "dev": "vite",
    "icons:sync": "node scripts/generate-icons-css.mjs",
    "sync:youtube": "node scripts/sync-youtube.mjs",
    "prebuild": "node scripts/sync-youtube.mjs && node scripts/generate-icons-css.mjs",
    "build": "vite-ssg build",
    "postbuild": "node scripts/postbuild.mjs",
    "preview": "vite preview",
    "lint": "eslint . --fix",
    "deploy": "bun run build",
    "sync:profile": "bun ../Curriculo/sync.mjs --no-pdf",
    "sync:agy": "bun ../Curriculo/sync-agy.mjs"
  },
  "dependencies": {
    "@fontsource-variable/space-grotesk": "^5.3.0",
    "@tailwindcss/vite": "^4.3.5",
