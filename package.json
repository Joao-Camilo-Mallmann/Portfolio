    "primeicons": "^8.0.2",
    "tailwindcss": "^4.3.5",
    "vue": "^3.5.45",
    "vue-router": "^5.5.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@unhead/vue": "^2.1.2",
    "@vitejs/plugin-vue": "^6.0.11",
    "@vue/eslint-config-prettier": "^10.2.0",
    "eslint": "^10.15.0",
    "eslint-plugin-vue": "^10.12.1",
    "globals": "^17.14.0",
    "prettier": "3.10.1",
    "vite": "^8.3.8",
    "vite-plugin-vue-devtools": "^8.2.1",
    "vite-ssg": "^28.3.0"
